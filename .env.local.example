# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook and automation engine). Keep this secret —
# never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Google Analytics 4 Measurement ID for the public marketing site
# (/, /precos, /contato). Leave empty to disable analytics — the
# marketing layout no-ops silently when this is unset. Never loaded
# on (auth)/(dashboard)/platform routes.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the first host on this list with
# a console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron and GET
# /api/flows/cron. Required for Wait steps, time-based triggers, the
# "conversation inactive" follow-up trigger and flow timeouts — all of
# them only advance when a scheduler calls those endpoints with the
# `x-cron-secret` header. The built-in scheduler is
# `scripts/cron-tick.mjs` (local: launch config "cron-tick"; VPS: PM2
# app `semprecrm-cron`). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Where scripts/cron-tick.mjs finds the app (default http://127.0.0.1:3100)
# and how often it ticks (ms, default 60000). CRON_HEALTH_PORT makes the
# script serve GET /health so a process manager can probe it.
# CALENDAR_SYNC_INTERVAL_MS is how often the same script calls
# POST /api/integrations/calendar/sync (Google / Outlook calendar sync,
# default 300000 = 5 min, never less than CRON_INTERVAL_MS).
# APP_URL=http://127.0.0.1:3100
# CRON_INTERVAL_MS=60000
# CALENDAR_SYNC_INTERVAL_MS=300000
# CRON_HEALTH_PORT=3301

# ------------------------------------------------------------
# Agenda — sincronização com Google Agenda e Outlook (opcional).
# ------------------------------------------------------------
# Cada usuário conecta a própria conta em Configurações → Agenda. Sem
# estas variáveis a tela mostra "Integração não configurada" e o resto da
# agenda funciona normalmente. Passo a passo (Google Cloud e Microsoft
# Entra) em docs/integracoes-agenda.md. URLs de redirecionamento a
# registrar no provedor:
#   ${NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
#   ${NEXT_PUBLIC_SITE_URL}/api/integrations/microsoft/callback
# (o Google só aceita "localhost" ou um domínio real — nunca um IP de rede
# local; em desenvolvimento conecte por http://localhost:<porta>, que o app
# usa como base do redirecionamento nesse caso). Os tokens ficam cifrados
# com ENCRYPTION_KEY.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Web Push (VAPID) — notificações no navegador (Configurações →
# Notificações). Sem as três variáveis o botão "Ativar neste navegador"
# fica desabilitado e nenhum push é enviado; o resto do app não muda.
# Gere o par de chaves uma vez e reutilize-o: trocar as chaves invalida
# todas as assinaturas salvas (os usuários precisam ativar de novo).
#   node scripts/gen-vapid.mjs >> .env.local
# VAPID_SUBJECT é o contato que o serviço de push (Google/Mozilla/Apple)
# pode usar — um `mailto:` ou uma URL https.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@semprecrm.local

# ------------------------------------------------------------
# Canal "WhatsApp via QR code" (WhatsApp Web) — opcional.
# ------------------------------------------------------------
# URL interna do serviço `services/wa-gateway` (Baileys). Local:
# `npm run dev` dentro de services/wa-gateway sobe na porta 3201.
# Na VPS o gateway roda no mesmo host via PM2 (`wa-gateway`), então o
# app fala com ele por loopback. Sem estas duas variáveis a opção
# "WhatsApp via QR code" aparece desabilitada em Configurações →
# WhatsApp com a mensagem "Gateway não configurado".
# WA_GATEWAY_URL=http://127.0.0.1:3201

# Segredo compartilhado entre o app e o gateway. Vai no header
# `x-gateway-secret` em todas as chamadas nos dois sentidos (app →
# gateway e gateway → /api/channels/qr/*). Use o MESMO valor em
# services/wa-gateway/.env. Gere com:
#   openssl rand -hex 32
# WA_GATEWAY_SECRET=generate-a-long-random-string

# Opcional: URL do Supabase vista pelo SERVIDOR quando ela difere da usada pelo
# navegador (app em container: http://host.docker.internal:56021; VPS tudo-em-um:
# http://127.0.0.1:8000 do Kong). O navegador continua com NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_INTERNAL_URL=
