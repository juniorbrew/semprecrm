# Porta HTTP interna do gateway (o app fala com ele em WA_GATEWAY_URL)
WA_GATEWAY_PORT=3201
# Endereço de escuta (padrão 127.0.0.1: só o próprio host). Em Docker, quando o
# app chama o gateway pelo nome do serviço, use 0.0.0.0 (a imagem já define).
# GATEWAY_BIND=127.0.0.1
# Segredo compartilhado com o app (header x-gateway-secret nos dois sentidos).
# Gere com: openssl rand -hex 32
WA_GATEWAY_SECRET=troque-por-um-segredo-longo
# URL do app Next.js que recebe os eventos (/api/channels/qr/*)
APP_URL=http://localhost:3101
# Supabase (service role) — usado só para subir mídia recebida no bucket chat-media
SUPABASE_URL=http://127.0.0.1:56021
SUPABASE_SERVICE_ROLE_KEY=
# Onde ficam as credenciais do WhatsApp de cada conta (uma pasta por account_id)
WA_DATA_DIR=./data
# trace | debug | info | warn | error
LOG_LEVEL=info
# Ficar online ao conectar (padrão true): o cliente vê ✓✓ (entregue) nas
# mensagens que manda. Com a sessão online o WhatsApp não notifica o celular
# principal; use false para priorizar as notificações do celular (o cliente
# verá só ✓ enquanto o celular principal estiver offline).
# WA_MARK_ONLINE=true

# Opcional: base das URLs públicas de mídia quando o gateway alcança o Supabase
# por outro endereço (Docker: SUPABASE_URL=http://host.docker.internal:56021 e
# SUPABASE_PUBLIC_URL=http://192.168.1.10:56021).
# SUPABASE_PUBLIC_URL=

# Opcional: origens EXTRAS (separadas por vírgula) de onde o gateway aceita
# baixar mídia para enviar. As origens de SUPABASE_URL e SUPABASE_PUBLIC_URL já
# são aceitas sempre; as extras são recusadas se resolverem para rede interna.
# MEDIA_ALLOWED_ORIGINS=https://cdn.exemplo.com
#
# IMPORTANTE (envio de mídia): a origem de SUPABASE_URL ou de SUPABASE_PUBLIC_URL
# tem de ser IGUAL à origem que o app manda em media.url — a de
# SUPABASE_INTERNAL_URL do app, se definida; senão a de NEXT_PUBLIC_SUPABASE_URL
# (ou NEXT_PUBLIC_SITE_URL quando ela é só `/supabase`). Se não bater, todo
# envio de mídia pelo QR falha com 400. Ex.: app sem SUPABASE_INTERNAL_URL e
# NEXT_PUBLIC_SUPABASE_URL=https://api.semprecrm.com.br → aqui
# SUPABASE_PUBLIC_URL=https://api.semprecrm.com.br.
