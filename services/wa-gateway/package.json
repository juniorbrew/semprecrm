{
  "name": "wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway WhatsApp por QR code (Baileys) do SempreCRM",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.116.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
